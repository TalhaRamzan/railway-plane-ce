# Plane CE (lean) - environment reference.
#
# On Railway you do NOT copy this file: the template sets these variables
# (see railway-template.md). This file is for `docker compose` local testing
# and documents every variable the Plane service understands.
# Never commit a filled-in copy (.env is git-ignored).

# ---------------------------------------------------------------------------
# Local docker compose secrets (required for local testing).
# Generate each with: openssl rand -hex 32
# ---------------------------------------------------------------------------
SECRET_KEY=
LIVE_SERVER_SECRET_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
S3_SECRET_KEY=

# ---------------------------------------------------------------------------
# Email via HTTPS API (optional). Railway blocks SMTP on Free/Trial/Hobby, so
# Plane talks to a local SMTP bridge that forwards to one of these APIs.
# ---------------------------------------------------------------------------
# resend | postmark | brevo
MAIL_PROVIDER=resend
MAIL_API_KEY=
# A sender verified with your provider, e.g. Plane <plane@yourdomain.com>
MAIL_FROM=

# ---------------------------------------------------------------------------
# Full list of Plane service variables (Railway values shown in comments).
# Uncomment only when running the image outside docker compose.
# ---------------------------------------------------------------------------
# Public host name, no scheme. Railway: ${{RAILWAY_PUBLIC_DOMAIN}}
# DOMAIN_NAME=
# http or https. Railway: https
# APP_PROTOCOL=https
# Port the bundled Caddy listens on. Railway: 80
# PORT=80

# Railway: ${{Postgres.DATABASE_URL}}
# DATABASE_URL=
# Railway: ${{Redis.REDIS_URL}}
# REDIS_URL=
# Leave empty to use Redis (database PLANE_BROKER_REDIS_DB) as the Celery
# broker. Set an amqp:// URL only if you add your own RabbitMQ.
# AMQP_URL=
# PLANE_BROKER_REDIS_DB=1

# Bucket. Railway: ${{Bucket.REGION}}, ${{Bucket.ACCESS_KEY_ID}},
# ${{Bucket.SECRET_ACCESS_KEY}}, ${{Bucket.BUCKET}}, ${{Bucket.ENDPOINT}}
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=
# virtual (Railway buckets) | path (MinIO and older buckets) | auto
# PLANE_S3_ADDRESSING_STYLE=virtual
# 1 = set the bucket CORS rule on every start, 0 = leave it alone
# PLANE_BUCKET_CORS=1
# Extra comma-separated origins for the bucket CORS rule
# PLANE_EXTRA_CORS_ORIGINS=
# Max upload size in bytes (10 MB)
# FILE_SIZE_LIMIT=10485760

# First-boot instance settings (stored in the database on the first start;
# change them later in /god-mode, not here).
# ENABLE_SIGNUP=0
# ENABLE_EMAIL_PASSWORD=1
# ENABLE_MAGIC_LINK_LOGIN=0
# ENABLE_SMTP=1
# EMAIL_HOST=127.0.0.1
# EMAIL_PORT=2525
# EMAIL_USE_TLS=0
# EMAIL_USE_SSL=0
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_FROM=Plane <plane@example.com>

# Process sizing (keep low to control the Railway bill)
# PLANE_WORKER_CONCURRENCY=2
# PLANE_WORKER_MAX_MEMORY_KB=393216
# PLANE_GUNICORN_WORKERS=1
